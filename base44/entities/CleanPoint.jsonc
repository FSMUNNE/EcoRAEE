{
  "name": "CleanPoint",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Nombre"
    },
    "address": {
      "type": "string",
      "title": "Direcci\u00f3n"
    },
    "lat": {
      "type": "number",
      "title": "Latitud"
    },
    "lng": {
      "type": "number",
      "title": "Longitud"
    },
    "municipality": {
      "type": "string",
      "title": "Municipio"
    },
    "province": {
      "type": "string",
      "title": "Provincia"
    },
    "country": {
      "type": "string",
      "title": "Pa\u00eds",
      "default": "Argentina"
    },
    "capacity": {
      "type": "number",
      "title": "Capacidad m\u00e1xima (kg)"
    },
    "current_load": {
      "type": "number",
      "title": "Carga actual (kg)",
      "default": 0
    },
    "hours": {
      "type": "string",
      "title": "Horarios"
    },
    "phone": {
      "type": "string",
      "title": "Tel\u00e9fono"
    },
    "accepted_categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Categor\u00edas aceptadas"
    },
    "is_active": {
      "type": "boolean",
      "title": "Activo",
      "default": true
    }
  },
  "required": [
    "name",
    "address",
    "lat",
    "lng",
    "municipality"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "administrador"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "municipio"
          }
        },
        {
          "user_condition": {
            "role": "operador"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "administrador"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "municipio"
          }
        },
        {
          "user_condition": {
            "role": "operador"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "administrador"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "municipio"
          }
        },
        {
          "user_condition": {
            "role": "operador"
          }
        }
      ]
    }
  }
}